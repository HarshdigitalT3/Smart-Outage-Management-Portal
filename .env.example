# Backend
NODE_ENV=development
BACKEND_PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/smart_outage

# Access JWT (Authorization: Bearer ...)
JWT_SECRET=replace-me
JWT_EXPIRES_IN=15m
JWT_ISSUER=
JWT_AUDIENCE=

# Refresh JWT (used by /api/auth/refresh)
REFRESH_JWT_SECRET=replace-me-too
REFRESH_JWT_EXPIRES_IN=7d

# bcrypt cost factor (optional; default 12)
BCRYPT_COST=12

# CORS
CORS_ORIGIN=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:4000
