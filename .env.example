# =========================
# Backend
# =========================
NODE_ENV=development
BACKEND_PORT=4000

# Database (PostgreSQL)
# Use a full connection string in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_outage

# JWT
JWT_SECRET=change_me_in_real_env
JWT_ISSUER=smart-outage-portal
JWT_AUDIENCE=smart-outage-portal-users
JWT_EXPIRES_IN=1h

# CORS
CORS_ORIGIN=http://localhost:5173

# =========================
# Frontend (Vite)
# =========================
VITE_API_BASE_URL=http://localhost:4000
